# Copy to ~/.config/agy-telegram-bridge/env and `chmod 600` it. Never commit the real file.

# Required
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN_FROM_BOTFATHER>
TELEGRAM_ALLOWED_USERS=<YOUR_NUMERIC_TELEGRAM_USER_ID>   # comma-separated for several users

# Optional (defaults shown)
#AGY_TRUST_MODE=restricted          # or "full": pre-approve commands/files/MCP, no sandbox (see README)
#AGY_WORKSPACE_DIR=~/.local/share/agy-telegram-bridge/workspace
#AGY_HOME=~/.gemini/antigravity-cli
#AGY_DAEMON_UNIT=antigravity-cli-daemon.service
#AGY_PROJECT_ID=telegram
#AGY_PROJECT_NAME=Telegram
#AGY_TURN_TIMEOUT=3000              # seconds to wait for a final answer
#AGY_LS_PORT=                       # force the language-server port
#AGY_CSRF_TOKEN=                    # force the daemon CSRF token (otherwise read from the daemon's command line)
#AGY_TELEGRAM_LOG_FILE=             # also log to a rotating file (5 MB x 3); default: stdout/journal only
