# Copy to ~/.config/agy-telegram-bridge/env and `chmod 600` it. Never commit the real file.
# systemd EnvironmentFile rules: one KEY=VALUE per line, comments only on their own line
# (a trailing "# ..." would become part of the value), no quotes needed.

# --- required ---
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN_FROM_BOTFATHER>

# Comma-separated numeric Telegram user IDs allowed to control the agent.
TELEGRAM_ALLOWED_USERS=<YOUR_NUMERIC_TELEGRAM_USER_ID>

# --- optional (defaults shown; uncomment to change) ---

# "restricted" or "full" (full = pre-approve commands/files/MCP and disable the sandbox; see README)
#AGY_TRUST_MODE=restricted

#AGY_WORKSPACE_DIR=~/.local/share/agy-telegram-bridge/workspace
#AGY_HOME=~/.gemini/antigravity-cli
#AGY_DAEMON_UNIT=antigravity-cli-daemon.service
#AGY_PROJECT_ID=telegram
#AGY_PROJECT_NAME=Telegram

# Seconds to wait for a final answer
#AGY_TURN_TIMEOUT=3000

# Force the language-server port / daemon CSRF token (otherwise auto-discovered)
#AGY_LS_PORT=
#AGY_CSRF_TOKEN=

# Also log to a rotating file (5 MB x 3); default is stdout/journal only
#AGY_TELEGRAM_LOG_FILE=
